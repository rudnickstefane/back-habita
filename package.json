{
  "name": "habita",
  "version": "1.0.0",
  "description": "API GraphQL do sistema imobiliário Habita",
  "author": "Habita",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.11.1",
    "pnpm": ">=10.23.0"
  },
  "scripts": {
    "commit": "git-cz",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "deps:check:prod": "pnpm deps:check",
    "deps:check": "pnpm dedupe --check",
    "format:base": "prettier \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "pnpm format:base --check",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node -r dd-trace/init dist/src/main",
    "migrate": "pnpm migrate:dev",
    "migrate:dev": "prisma migrate dev",
    "migrate:reset": "prisma migrate reset",
    "migrate:prod": "prisma migrate deploy",
    "migrate:all:deploy": "node migrations.run.mjs",
    "db:push": "prisma db push",
    "prisma": "prisma",
    "prisma:studio": "prisma studio",
    "prisma:format": "prisma format",
    "prisma:generate": "prisma generate",
    "prisma:seed": "ts-node --transpile-only prisma/seed.ts",
    "command": "node dist/src/console.js",
    "command:dev": "npx ts-node -r tsconfig-paths/register src/console.ts",
    "command:prod": "node -r dd-trace/init dist/src/console.js",
    "command:invoice-plans": "node dist/src/commands/commands.main.js",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prepare": "pnpm husky",
    "preinstall": "node check-node.js && npx only-allow pnpm"
  },
  "dependencies": {
    "@apollo/server": "^5.2.0",
    "@as-integrations/fastify": "^3.1.0",
    "@fastify/multipart": "^9.3.0",
    "@fastify/static": "^8.3.0",
    "@nestjs/apollo": "^13.2.1",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/graphql": "^13.2.0",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/platform-fastify": "^11.1.9",
    "@nestjs/serve-static": "^5.0.4",
    "@nestjs/terminus": "^11.0.0",
    "@prisma/adapter-pg": "^7.0.1",
    "@prisma/client": "^7.0.0",
    "@types/graphql-upload": "^17.0.0",
    "@types/multer": "^2.0.0",
    "@types/request-ip": "^0.0.41",
    "argon2": "^0.44.0",
    "axios": "^1.13.2",
    "bull": "^4.16.5",
    "cache-manager": "^7.2.5",
    "cache-manager-ioredis-yet": "^2.1.2",
    "cache-manager-redis-yet": "^5.1.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dd-trace": "^5.80.0",
    "dotenv": "^17.2.3",
    "fs-extra": "^11.3.2",
    "googleapis": "^166.0.0",
    "graphql": "^16.12.0",
    "graphql-upload": "^17.0.0",
    "handlebars": "^4.7.8",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "mercadopago": "^2.10.0",
    "nest-commander": "^3.20.1",
    "nestjs-console": "^10.0.0",
    "nestjs-pino": "^4.4.1",
    "nodemailer": "^7.0.10",
    "only-allow": "^1.2.1",
    "otplib": "^12.0.1",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "pino-elasticsearch": "^8.1.0",
    "pino-multi-stream": "^6.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "request-ip": "^3.3.0",
    "rxjs": "^7.8.2",
    "ua-parser-js": "^2.0.9"
  },
  "devDependencies": {
    "@digitalroute/cz-conventional-changelog-for-jira": "^8.0.1",
    "@eslint/js": "^9.39.1",
    "@faker-js/faker": "^10.1.0",
    "@nestjs/cli": "^11.0.12",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.9",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "@types/ua-parser-js": "^0.7.39",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "better-sqlite3": "^12.4.6",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "fishery": "^2.3.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-fetch-mock": "^3.0.3",
    "jest-mock-extended": "^4.0.0",
    "lint-staged": "^16.2.7",
    "pino-pretty": "^13.1.2",
    "prettier": "^3.6.2",
    "prisma": "^7.0.0",
    "rimraf": "^6.1.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.module.(t|j)s",
      "!config/*.(t|j)s",
      "!main.(t|j)s",
      "!console.(t|j)s"
    ],
    "setupFiles": [
      "../jest.setup.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "@src/(.*)": "<rootDir>/$1",
      "@example/(.*)": "<rootDir>/example/$1",
      "@health-check/(.*)": "<rootDir>/health-check/$1",
      "@config/(.*)": "<rootDir>/config/$1",
      "@test/(.*)": "<rootDir>/../test/$1",
      "@utils/(.*)": "<rootDir>/utils/$1"
    }
  },
  "config": {
    "commitizen": {
      "path": "./commitizen.config"
    }
  },
  "lint-staged": {
    "*.{css,less,scss,html,json}": [
      "prettier --write"
    ],
    "*.{jsx,tsx,js,ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
